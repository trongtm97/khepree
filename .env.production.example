# Khepree production VPS — copy to /etc/khepree/.env.production on the server only.
# Never commit .env.production or real secrets to git.
#
# Shared VPS (with CHAPMEE):
#   docker compose -f compose.shared-vps.yml --env-file /etc/khepree/.env.production up -d
#
# Dedicated VPS (includes Caddy):
#   docker compose -f compose.production.yml --env-file /etc/khepree/.env.production up -d

# --- PostgreSQL (internal: khepree-postgres:5432 on shared VPS) ---
POSTGRES_USER=CHANGE_ME_db_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=CHANGE_ME_db_name

# --- Redis (internal: khepree-redis:6379 on shared VPS) ---
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# --- Public URLs (HTTPS) ---
WEB_URL=https://khepree.com
APP_URL=https://khepree.com
ACCOUNT_URL=https://account.khepree.com
ADMIN_URL=https://admin.khepree.com
PARTNER_URL=https://partner.khepree.com
API_URL=https://api.khepree.com

NEXT_PUBLIC_WEB_URL=https://khepree.com
NEXT_PUBLIC_ACCOUNT_URL=https://account.khepree.com
NEXT_PUBLIC_ADMIN_URL=https://admin.khepree.com
NEXT_PUBLIC_PARTNER_URL=https://partner.khepree.com

# --- TLS (dedicated VPS Caddy only — shared VPS uses chapmee-caddy) ---
CADDY_ACME_EMAIL=ops@CHANGE_ME_domain.com

# --- Auth ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=CHANGE_ME_minimum_32_characters_entropy
BETTER_AUTH_URL=https://account.khepree.com

# cloudflare = DNS proxied through Cloudflare. none = direct DNS to VPS.
TRUSTED_PROXY=none

# --- Object storage (Vietnix S3-compatible — preferred in production) ---
STORAGE_PROVIDER=s3
S3_ENDPOINT=https://CHANGE_ME.vietnix-object-storage.example
S3_REGION=auto
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET_PUBLIC=khepree-public
S3_BUCKET_PRIVATE=khepree-private
S3_PUBLIC_BASE_URL=https://cdn.khepree.com
# Vietnix/MinIO typically need path-style URLs:
S3_FORCE_PATH_STYLE=true

# --- Legacy Cloudflare R2 (optional fallback when S3_* unset) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_PUBLIC=
# R2_BUCKET_PRIVATE=
# R2_PUBLIC_BASE_URL=

# --- License signing (Ed25519) — see docs/LICENSE-SIGNING.md ---
LICENSE_SIGNING_PRIVATE_KEY=CHANGE_ME
LICENSE_SIGNING_PUBLIC_KEY=CHANGE_ME

# --- Email (SMTP production — separate mailbox from CHAPMEE) ---
EMAIL_PROVIDER=smtp
MAIL_FROM=Khepree <no-reply@khepree.com>
MAIL_REPLY_TO=support@khepree.com
SMTP_HOST=CHANGE_ME_smtp_host
SMTP_PORT=587
SMTP_USER=CHANGE_ME_smtp_user
SMTP_PASS=CHANGE_ME_smtp_password
SMTP_SECURE=true

# Resend alternative (set EMAIL_PROVIDER=resend and unset SMTP_*):
# EMAIL_PROVIDER=resend
# EMAIL_FROM=Khepree <no-reply@khepree.com>
# EMAIL_PROVIDER_API_KEY=CHANGE_ME

# --- Payment (SePay) ---
# Keep sandbox until B1 end-to-end gate passes (docs/SEPAY-SANDBOX.md).
# SEPAY_ENV=production is a MANUAL go-live step — never set by deploy automation.
PAYMENT_PROVIDER=sepay
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=CHANGE_ME_sandbox_merchant
SEPAY_SECRET_KEY=CHANGE_ME_sandbox_secret
SEPAY_IPN_SECRET=

# --- Outbox worker ---
OUTBOX_WORKER_SECRET=CHANGE_ME_outbox_bearer_secret
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=20
OUTBOX_LOCK_TIMEOUT_MS=300000
OUTBOX_MAX_ATTEMPTS=12

# --- Database pool (single VPS) ---
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT=20
DATABASE_CONNECT_TIMEOUT=10

# --- Google OAuth (production client — separate from CHAPMEE) ---
# Authorized origin: https://account.khepree.com
# Redirect URI: https://account.khepree.com/api/auth/callback/google
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# Optional: Sentry error tracking (install @sentry/node in image to enable)
# SENTRY_DSN=

# --- Image tags (set by CI/CD deploy — do NOT use :latest) ---
# KHEPREE_WEB_IMAGE=ghcr.io/myorg/khepree-web:abc1234
# KHEPREE_ACCOUNT_IMAGE=ghcr.io/myorg/khepree-account:abc1234
# KHEPREE_ADMIN_IMAGE=ghcr.io/myorg/khepree-admin:abc1234
# KHEPREE_PARTNER_IMAGE=ghcr.io/myorg/khepree-partner:abc1234
# KHEPREE_API_IMAGE=ghcr.io/myorg/khepree-api:abc1234
# KHEPREE_WORKER_IMAGE=ghcr.io/myorg/khepree-outbox-worker:abc1234
# KHEPREE_MIGRATE_IMAGE=ghcr.io/myorg/khepree-migrate:abc1234
