# Khepree production VPS — copy to .env.production on the server only.
# Never commit .env.production or real secrets to git.
#
# docker compose -f compose.production.yml --env-file .env.production up -d

# --- PostgreSQL (internal: postgres:5432) ---
POSTGRES_USER=CHANGE_ME_db_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=CHANGE_ME_db_name

# --- Redis (internal: redis:6379) ---
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# --- Public URLs (HTTPS) ---
WEB_URL=https://khepree.com
APP_URL=https://khepree.com
ACCOUNT_URL=https://account.khepree.com
ADMIN_URL=https://admin.khepree.com
PARTNER_URL=https://partner.khepree.com
API_URL=https://api.khepree.com

NEXT_PUBLIC_WEB_URL=https://khepree.com
NEXT_PUBLIC_ACCOUNT_URL=https://account.khepree.com
NEXT_PUBLIC_ADMIN_URL=https://admin.khepree.com
NEXT_PUBLIC_PARTNER_URL=https://partner.khepree.com

# --- TLS (Caddy ACME) ---
CADDY_ACME_EMAIL=ops@CHANGE_ME_domain.com

# --- Auth ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=CHANGE_ME_minimum_32_characters_entropy
BETTER_AUTH_URL=https://account.khepree.com

# Behind Cloudflare orange-cloud proxy only (see docs/VPS-SECURITY.md)
TRUSTED_PROXY=cloudflare

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_PUBLIC=CHANGE_ME_public_bucket
R2_BUCKET_PRIVATE=CHANGE_ME_private_bucket
R2_PUBLIC_BASE_URL=https://cdn.khepree.com

# --- License signing (Ed25519) — see docs/LICENSE-SIGNING.md ---
LICENSE_SIGNING_PRIVATE_KEY=CHANGE_ME
LICENSE_SIGNING_PUBLIC_KEY=CHANGE_ME

# --- Email ---
EMAIL_PROVIDER=resend
EMAIL_FROM=Khepree <no-reply@khepree.com>
EMAIL_PROVIDER_API_KEY=CHANGE_ME

# --- Payment (SePay) ---
# Keep sandbox until B1 end-to-end gate passes (docs/SEPAY-SANDBOX.md).
# SEPAY_ENV=production is a MANUAL go-live step — never set by deploy automation.
PAYMENT_PROVIDER=sepay
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=CHANGE_ME_sandbox_merchant
SEPAY_SECRET_KEY=CHANGE_ME_sandbox_secret
SEPAY_IPN_SECRET=

# --- Outbox worker ---
# Required if using POST /api/v1/internal/outbox/run (Bearer auth).
# Dedicated worker container in compose.production.yml does not need HTTP cron.
OUTBOX_WORKER_SECRET=CHANGE_ME_outbox_bearer_secret
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=20
OUTBOX_LOCK_TIMEOUT_MS=300000
OUTBOX_MAX_ATTEMPTS=12

# --- Database pool (single VPS) ---
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT=20
DATABASE_CONNECT_TIMEOUT=10

# --- Optional: Google OAuth (production client — separate from localhost dev client) ---
# Authorized origin: https://account.khepree.com
# Redirect URI: https://account.khepree.com/api/auth/callback/google
# Button hidden when unset (isGoogleAuthConfigured).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MAINTENANCE_MODE=

# Optional: Sentry error tracking (install @sentry/node in image to enable)
# SENTRY_DSN=

# --- Image tags (set by CI/CD deploy — do NOT use :latest) ---
# Example after deploy:
# KHEPREE_WEB_IMAGE=ghcr.io/myorg/khepree-web:abc1234
# KHEPREE_ACCOUNT_IMAGE=ghcr.io/myorg/khepree-account:abc1234
# KHEPREE_ADMIN_IMAGE=ghcr.io/myorg/khepree-admin:abc1234
# KHEPREE_PARTNER_IMAGE=ghcr.io/myorg/khepree-partner:abc1234
# KHEPREE_API_IMAGE=ghcr.io/myorg/khepree-api:abc1234
# KHEPREE_WORKER_IMAGE=ghcr.io/myorg/khepree-outbox-worker:abc1234
# KHEPREE_MIGRATE_IMAGE=ghcr.io/myorg/khepree-migrate:abc1234
