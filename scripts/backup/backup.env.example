# Khepree off-VPS backup configuration. Copy to /etc/khepree/backup.env on the VPS.
# chmod 600, root:root. Never commit real values.

# rclone remote path for encrypted dumps (required — Docker volume is NOT a backup)
# Example after `rclone config`: r2-khepree-backups:khepree/postgres
BACKUP_RCLONE_REMOTE=CHANGE_ME_rclone_remote_path

# Local staging (deleted after successful upload by default)
BACKUP_LOCAL_DIR=/var/backups/khepree/postgres

# GPG symmetric passphrase file (generate: openssl rand -base64 32 > /etc/khepree/backup.passphrase && chmod 600)
BACKUP_PASSPHRASE_FILE=/etc/khepree/backup.passphrase

# GFS retention on the remote (configurable)
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=3

# Pre-migrate / monitoring: warn or block if last success older than this (hours)
BACKUP_MAX_AGE_HOURS=26

# Restore safety: comma-separated host markers refused as restore targets
PRODUCTION_DB_HOST_MARKERS=postgres

# Optional: exact production DATABASE_URL to refuse for restore
# PRODUCTION_DATABASE_URL=postgresql://user:pass@postgres:5432/dbname

# Keep local encrypted copy after upload (default: delete after upload succeeds)
# BACKUP_KEEP_LOCAL=1
