{
  "name": "@khepree/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./audit": "./src/audit/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed/index.ts"
  },
  "dependencies": {
    "@khepree/config": "workspace:*",
    "@khepree/types": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "postgres": "^3.4.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@khepree/eslint-config": "workspace:*",
    "@khepree/typescript-config": "workspace:*",
    "@types/node": "^22.18.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.34.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
