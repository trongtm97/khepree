# Khepree Platform — Environment Template
# Copy to .env and fill in values. Never commit real secrets.

NODE_ENV=development

# --- App URLs (development) ---
APP_URL=http://localhost:3000
ACCOUNT_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
PARTNER_URL=http://localhost:3003
API_URL=http://localhost:3004

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ACCOUNT_URL=http://localhost:3001

# --- Social (optional — footer shows only when URLs are set) ---
NEXT_PUBLIC_SOCIAL_TWITTER=
NEXT_PUBLIC_SOCIAL_GITHUB=
NEXT_PUBLIC_SOCIAL_LINKEDIN=

# --- Database ---
# Status: NOT CONFIGURED until set
DATABASE_URL=postgresql://khepree:khepree_local@localhost:5432/khepree_local

# --- Auth (Better Auth) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
BETTER_AUTH_URL=http://localhost:3001

# --- Cloudflare R2 (S3-compatible) ---
# Status: NOT CONFIGURED — storage falls back to MOCK in development
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=
R2_BUCKET_PRIVATE=
R2_PUBLIC_BASE_URL=

# --- License signing (Ed25519) ---
# Status: NOT CONFIGURED — server-only, never commit private key
LICENSE_SIGNING_PRIVATE_KEY=
LICENSE_SIGNING_PUBLIC_KEY=

# --- Email ---
# Status: NOT CONFIGURED — falls back to MOCK in development
EMAIL_FROM=Khepree <no-reply@khepree.com>
EMAIL_PROVIDER_API_KEY=

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
