# Khepree Platform — Environment Template
# Copy to .env and fill in values. Never commit real secrets.
# Environment isolation: docs/ENVIRONMENTS.md
# Production signing keys: docs/LICENSE-SIGNING.md (do not generate keys into this file)

NODE_ENV=development

# --- App URLs (development) ---
WEB_URL=http://localhost:3000
APP_URL=
ACCOUNT_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
PARTNER_URL=http://localhost:3003
API_URL=http://localhost:3004
# STATUS_URL=https://status.khepree.com
# DOWNLOAD_URL=https://download.khepree.com

NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ACCOUNT_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
NEXT_PUBLIC_PARTNER_URL=http://localhost:3003

# --- Social (optional — footer shows only when URLs are set) ---
NEXT_PUBLIC_SOCIAL_TWITTER=
NEXT_PUBLIC_SOCIAL_GITHUB=
NEXT_PUBLIC_SOCIAL_LINKEDIN=

# --- Database ---
# Status: NOT CONFIGURED until set
# Default matches docker-compose postgres. If host 5432 is already used, set
# POSTGRES_PORT and the port in DATABASE_URL to the same value (e.g. 5434).
POSTGRES_PORT=5432
DATABASE_URL=postgresql://khepree:khepree_local@localhost:5432/khepree_local

# --- Auth (Better Auth) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
BETTER_AUTH_URL=http://localhost:3001

# --- Object storage (S3-compatible — Vietnix, MinIO, or Cloudflare R2) ---
# Development: omit to use MockObjectStorage (dev/test only).
# Production/staging: BOTH buckets required — private NEVER falls back to public.
#
# Preferred (Vietnix / generic S3):
STORAGE_PROVIDER=s3
S3_ENDPOINT=https://s3.vn-hcm-1.vietnix.cloud
S3_REGION=vn-hcm-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=khepree-public
S3_BUCKET_PRIVATE=khepree-private
S3_PUBLIC_BASE_URL=https://cdn.khepree.com
# HTTPS CDN origin for public media (e.g. https://cdn.khepree.com) — NOT the S3 API endpoint.
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_ACCESS_MODE=acl

# --- License signing (Ed25519) ---
# Status: NOT CONFIGURED — server-only, never commit private key
# Generate (do not commit the output):
# node -e "const {generateKeyPairSync}=require('crypto'); const k=generateKeyPairSync('ed25519'); console.log(k.privateKey.export({type:'pkcs8',format:'der'}).toString('base64')); console.log(k.publicKey.export({type:'spki',format:'der'}).toString('base64'))"
LICENSE_SIGNING_PRIVATE_KEY=
LICENSE_SIGNING_PUBLIC_KEY=

# Optional public contact mailboxes (marketing site). Billing/security cards hidden until set.
# PUBLIC_CONTACT_HELLO=hello@khepree.com
# PUBLIC_CONTACT_SUPPORT=support@khepree.com
# PUBLIC_CONTACT_BILLING=billing@khepree.com
# PUBLIC_CONTACT_SECURITY=security@khepree.com
# PUBLIC_CONTACT_PRIVACY=privacy@khepree.com

# Development default: EMAIL_PROVIDER=dev (logs only, never claims delivery).
# Production: EMAIL_PROVIDER=smtp or resend with complete settings.
EMAIL_PROVIDER=dev
MAIL_FROM=Khepree <no-reply@khepree.com>
MAIL_REPLY_TO=support@khepree.com
EMAIL_FROM=Khepree <no-reply@khepree.com>
EMAIL_PROVIDER_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Shared rate-limit store (optional in dev). Required in production multi-instance.
REDIS_URL=

# Outbox worker (Phase 17 / 21)
OUTBOX_LOCK_TIMEOUT_MS=300000
OUTBOX_MAX_ATTEMPTS=12
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=20
# Bearer secret for POST /api/v1/internal/outbox/run
OUTBOX_WORKER_SECRET=

# Database pool (single VPS defaults)
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT=20
DATABASE_CONNECT_TIMEOUT=10

# --- Payment provider ---
# Domain stays provider-agnostic. Mock is the development adapter only.
# Production must use PAYMENT_PROVIDER=sepay with merchant credentials.
# Do not add Stripe (or other) SDK objects to commerce records.
# Never put SePay secrets in NEXT_PUBLIC_*.
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_WEBHOOK_SECRET=dev-mock-webhook-secret

# SePay VietQR bank transfer (same model as CHAPMEE)
# Webhook docs: https://developer.sepay.vn/vi/sepay-webhooks/tich-hop-webhook
SEPAY_ENV=production
SEPAY_BANK_CODE=MBBank
SEPAY_BANK_ACCOUNT_NUMBER=
SEPAY_BANK_ACCOUNT_NAME=
SEPAY_WEBHOOK_SECRET=
# Optional: use API Key auth instead of HMAC
# SEPAY_WEBHOOK_AUTH=api_key
# SEPAY_API_KEY=
# SEPAY_QR_BASE_URL=https://qr.sepay.vn/img

# Trusted proxy for client IP (rate limits). none ignores X-Forwarded-For.
# cloudflare = CF-Connecting-IP only. Multi-instance rate limits need Redis (P1).
TRUSTED_PROXY=none

# --- Observability / ops ---
# Set to 1 to return 503 from edge proxy (maintenance window).
MAINTENANCE_MODE=

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
