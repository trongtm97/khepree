# syntax=docker/dockerfile:1

ARG NODE_VERSION=22-bookworm-slim

FROM node:${NODE_VERSION} AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps ./apps
COPY packages ./packages
COPY tooling ./tooling
RUN pnpm install --frozen-lockfile

FROM deps AS builder
COPY . .
ENV CI=true
RUN pnpm --filter @khepree/platform build:worker

FROM node:${NODE_VERSION} AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN groupadd --system --gid 1001 khepree \
  && useradd --system --uid 1001 --gid khepree khepree

COPY --from=builder --chown=khepree:khepree /app/packages/platform/dist/outbox-worker.cjs ./dist/outbox-worker.cjs

USER khepree

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "process.exit(0)"

CMD ["node", "dist/outbox-worker.cjs"]
